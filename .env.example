# Sluice configuration reference. Copy only the values you need into your
# deployment secret store or process environment. Never commit populated secrets.

# Frontend / backend-for-frontend
API_BASE_URL=http://localhost:8080/api/v1
SLUICE_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
SLUICE_DASHBOARD_URL=http://localhost:3000

# PostgreSQL and Flyway
SLUICE_DB_URL=jdbc:postgresql://localhost:5432/sluice
SLUICE_DB_USERNAME=sluice
SLUICE_DB_PASSWORD=<DATABASE_PASSWORD>
SLUICE_FLYWAY_URL=jdbc:postgresql://localhost:5432/sluice
SLUICE_FLYWAY_USERNAME=sluice
SLUICE_FLYWAY_PASSWORD=<DATABASE_PASSWORD>

# Authentication and browser access
SLUICE_JWT_SECRET=<LONG_RANDOM_JWT_SIGNING_SECRET>
SLUICE_CORS_ALLOWED_ORIGINS=http://localhost:3000
SLUICE_ACTUATOR_PUBLIC_PROMETHEUS=false
SLUICE_AUTH_AUDIT_PEPPER=<LONG_RANDOM_AUDIT_HASHING_SECRET>
SLUICE_AUTH_FRONTEND_BASE_URL=http://localhost:3000
SLUICE_AUTH_VERIFICATION_TTL_SECONDS=86400
SLUICE_AUTH_RESET_TTL_SECONDS=1800
SLUICE_AUTH_ABUSE_WINDOW_SECONDS=900
SLUICE_AUTH_ABUSE_MAX_ENTRIES=10000
SLUICE_AUTH_SIGNUP_LIMIT=5
SLUICE_AUTH_LOGIN_LIMIT=10
SLUICE_AUTH_VERIFICATION_LIMIT=8
SLUICE_AUTH_RECOVERY_LIMIT=5
SLUICE_AUTH_RESET_LIMIT=8
SLUICE_AUTH_EMAIL_EXECUTOR_THREADS=2
SLUICE_AUTH_EMAIL_QUEUE_CAPACITY=200

# Azure Communication Services Email. Required by the production profile.
AZURE_COMMUNICATION_EMAIL_ENDPOINT=<AZURE_COMMUNICATION_EMAIL_ENDPOINT>
AZURE_COMMUNICATION_EMAIL_ACCESS_KEY=<AZURE_COMMUNICATION_EMAIL_ACCESS_KEY>
AZURE_COMMUNICATION_EMAIL_SENDER=<VERIFIED_SENDER_ADDRESS>
AZURE_COMMUNICATION_EMAIL_API_VERSION=2025-09-01
AZURE_COMMUNICATION_EMAIL_TIMEOUT_MILLIS=5000

# Blob storage
AZURE_STORAGE_CONNECTION_STRING=<AZURE_OR_AZURITE_CONNECTION_STRING>
AZURE_STORAGE_CONTAINER_NAME=assets
AZURE_STORAGE_CONFIGURE_CORS=false

# Upload and processor safety limits
SLUICE_MEDIA_MAX_UPLOAD_BYTES=50000000
SLUICE_MEDIA_MAX_REQUEST_BYTES=51000000
SLUICE_MEDIA_MAX_FILENAME_LENGTH=255
SLUICE_MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,application/pdf,video/mp4
SLUICE_IMAGE_MAX_INPUT_BYTES=50000000
SLUICE_IMAGE_MAX_OUTPUT_BYTES=50000000
SLUICE_IMAGE_MAX_PIXELS=40000000
SLUICE_IMAGE_MAX_DIMENSION=10000
SLUICE_IMAGE_TIMEOUT_MILLIS=30000
SLUICE_OUTBOX_PUBLISHER_CONFIRM_TIMEOUT=5s

# Governance. Use local for the no-credential local adapter.
SLUICE_GOVERNANCE_PROVIDER=local
AZURE_CONTENT_SAFETY_ENDPOINT=<AZURE_CONTENT_SAFETY_ENDPOINT>
AZURE_CONTENT_SAFETY_API_KEY=<AZURE_CONTENT_SAFETY_API_KEY>
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01
AZURE_CONTENT_SAFETY_TIMEOUT_MILLIS=5000
