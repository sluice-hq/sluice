{
  "schemaVersion": "1",
  "slug": "webp",
  "version": "2.0.0",
  "displayName": "WebP Encoder",
  "description": "Deterministic lossy WebP encoding with metadata removed by default",
  "category": "compression",
  "input": {"kind": "image", "mimeTypes": ["image/jpeg", "image/png", "image/webp"], "maxBytes": 50000000, "maxPixels": 40000000, "alphaSupported": true, "animationSupported": false},
  "output": {"kind": "image", "mimeTypes": ["image/webp"], "maxBytes": 50000000, "maxPixels": 40000000, "alphaSupported": true, "animationSupported": false},
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {"quality": {"type": "integer", "minimum": 40, "maximum": 95}}
  },
  "limits": {"timeoutSeconds": 30, "memoryMb": 512, "maxOutputBytes": 50000000},
  "permissions": ["blob.read.input", "blob.write.output"],
  "status": "PUBLISHED",
  "releaseNotes": "Pinned webp-imageio 0.11.0, default quality 82, deterministic single-threaded settings, metadata stripping, and compression facts"
}
