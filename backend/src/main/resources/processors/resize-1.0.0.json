{
  "schemaVersion": "1",
  "slug": "resize",
  "version": "1.0.0",
  "displayName": "Image Resize",
  "description": "First-party Sluice image resize processor",
  "category": "transform",
  "input": {"kind": "image", "mimeTypes": ["image/*"], "maxBytes": 50000000, "maxPixels": 40000000, "alphaSupported": true, "animationSupported": false},
  "output": {"kind": "image", "mimeTypes": ["image/jpeg"], "maxBytes": 50000000, "maxPixels": 25000000, "alphaSupported": false, "animationSupported": false},
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "width": {"type": "integer", "minimum": 1, "maximum": 5000},
      "height": {"type": "integer", "minimum": 1, "maximum": 5000}
    }
  },
  "limits": {"timeoutSeconds": 30, "memoryMb": 512, "maxOutputBytes": 50000000},
  "permissions": ["blob.read.input", "blob.write.output"],
  "status": "PUBLISHED",
  "releaseNotes": "Initial built-in release"
}
